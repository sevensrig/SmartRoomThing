{
  "name": "smartroomthing-webapp-checks",
  "private": true,
  "description": "Lint the Car Thing webapp against the Chromium 69 it actually runs on.",
  "browserslist": [
    "chrome 69"
  ],
  "scripts": {
    "lint": "npm run lint:js && npm run lint:css",
