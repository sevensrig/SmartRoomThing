# Oneshot service that sets up the adb reverse tunnel for the Car Thing.
# Triggered by udev (udev/99-carthing-adb.rules) when the device is plugged in.
#
# Install:
#   sudo cp adb-reverse.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#
# It is started automatically by the udev rule, but you can also run it by hand:
#   sudo systemctl start adb-reverse
#   journalctl -u adb-reverse -f
#
# Adjust the ExecStart path if your repo isn't at /home/pi/SmartRoomThing.

[Unit]
Description=adb reverse tunnel for Spotify Car Thing (localhost:5005 -> Pi server)
# The tunnel is only useful once the server is up, but it does not hard-depend
# on it: if the server starts later, the device just retries reaching it.
After=volumepresets.service

[Service]
Type=oneshot
ExecStart=/home/pi/SmartRoomThing/adb-reverse.sh
# Run as root (udev-triggered): full access to the USB device and the adb server.
StandardOutput=journal
StandardError=journal
