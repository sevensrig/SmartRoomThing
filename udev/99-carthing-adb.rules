# udev rule: when the Spotify Car Thing is plugged into USB, start the
# adb-reverse oneshot service that establishes the localhost:5005 tunnel.
#
# Install:
#   sudo cp udev/99-carthing-adb.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules
#   sudo udevadm trigger
#
# IMPORTANT — verify the device's USB IDs match yours before relying on this.
# With the Car Thing plugged in, run:
#   lsusb                       # find the "Google Inc." / Car Thing line -> ID xxxx:yyyy
#   udevadm monitor --udev --subsystem-match=usb   # watch the add event on plug-in
# then set idVendor/idProduct below to match. The values here (Google's adb
# composite, 18d1:4e40) are the common Car Thing adb-mode IDs but may differ.
#
# TAG+="systemd" + ENV{SYSTEMD_WANTS} is the documented way to start a systemd
# unit from a udev "add" event.

ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="18d1", ATTR{idProduct}=="4e40", TAG+="systemd", ENV{SYSTEMD_WANTS}+="adb-reverse.service"
