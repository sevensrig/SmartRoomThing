# Secrets — real config with HA token + Spotify secret/refresh token.
# Copy presets.example.json -> presets.json and fill in your own values.
presets.json

# Dashboard config. Separate from presets.json so the two services never share
# a blast radius; it will hold the calendar/mail/Slack credentials.
# Copy dashboard.example.json -> dashboard.json and fill in your own values.
dashboard.json

# Sleeper's bulk player map, projected down to names/positions. Rebuilt
# weekly by dashboard.playercache; derived data, not worth versioning.
player_cache.json

